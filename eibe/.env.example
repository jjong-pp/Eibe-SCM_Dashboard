# EIBE Unified Platform — 환경 설정 예시
# 이 파일을 `.env` 로 복사한 뒤 값을 채운다. `.env` 는 git에 커밋하지 않는다.

# ── 실행 환경 ────────────────────────────────────────────────────────
# local | staging | production
EIBE_ENV=local
EIBE_DEBUG=true
EIBE_LOG_LEVEL=INFO

# ── 데이터베이스 ─────────────────────────────────────────────────────
# SQLite (기본):
#   EIBE_DATABASE_URL=sqlite:///./data/eibe.db
# PostgreSQL (Firebase Data Connect / Cloud SQL):
#   EIBE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/eibe
EIBE_DATABASE_URL=
EIBE_DB_ECHO=false
EIBE_DB_POOL_SIZE=5
EIBE_DB_MAX_OVERFLOW=10

# ── 인증 ─────────────────────────────────────────────────────────────
# production 에서는 반드시 설정. 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
EIBE_SECRET_KEY=
EIBE_ACCESS_TOKEN_EXPIRE_MINUTES=720
# HTTPS 배포 시 true
EIBE_COOKIE_SECURE=false
EIBE_COOKIE_SAMESITE=lax

# ── 최초 관리자 계정 ─────────────────────────────────────────────────
# 비워두면 관리자 계정을 만들지 않는다. production 에서는 약한 비밀번호를 거부한다.
EIBE_BOOTSTRAP_ADMIN_USERNAME=admin
EIBE_BOOTSTRAP_ADMIN_PASSWORD=
EIBE_BOOTSTRAP_ADMIN_NAME=시스템 관리자

# ── 사내 도메인 (쉼표 구분, 비우면 제한 없음) ────────────────────────
EIBE_STAFF_EMAIL_DOMAINS=eibe.co.kr,btmall.kr

# ── CORS (쉼표 구분, 비우면 동일 출처만 허용) ────────────────────────
EIBE_CORS_ORIGINS=

# ── 업로드 / 배치 ────────────────────────────────────────────────────
EIBE_UPLOAD_MAX_MB=20
EIBE_WRITE_BATCH_SIZE=500

# ── 표시 기본값 ──────────────────────────────────────────────────────
EIBE_DEFAULT_LOCALE=ko-KR
EIBE_DEFAULT_TIMEZONE=Asia/Seoul
EIBE_DEFAULT_CURRENCY=KRW
